<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
             x:Class="MeteoApp.Views.MeteoMapPage"
             Title="Trova Località">

    <Grid RowDefinitions="Auto, *, Auto">

        <VerticalStackLayout Grid.Row="0" Margin="10" ZIndex="1">
            <SearchBar Text="{Binding SearchText}" 
                       Placeholder="Cerca una città (es. Milano)..." />

            <CollectionView x:Name="suggestionsView"
                            ItemsSource="{Binding SearchManager.Suggestions}"
                            IsVisible="{Binding SearchManager.IsSuggestionsVisible}"
                            SelectionMode="Single"
                            SelectionChanged="OnSuggestionSelected"
                            BackgroundColor="White"
                            MaximumHeightRequest="200">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Label Text="{Binding Description}" Padding="10" FontSize="16" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>

        <maps:Map x:Name="myMap" 
                  Grid.Row="1" 
                  MapType="Street" 
                  MapClicked="OnMapClicked"
                  IsShowingUser="True" />

        <Button Grid.Row="2" 
                Text="Salva Località" 
                Clicked="OnSaveClicked" 
                Margin="20" />
    </Grid>
</ContentPage>