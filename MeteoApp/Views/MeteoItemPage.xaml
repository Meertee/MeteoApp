<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MeteoApp.MeteoItemPage"
             Title="Dettagli Località">

    <StackLayout x:Name="MainLayout" Spacing="20" Margin="20">

        <Label Text="{Binding CityName}"
               FontSize="45"
               FontAttributes="Bold"
               HorizontalOptions="Center" 
               VerticalOptions="Start" />

        <Label Text="{Binding CurrentTemp, StringFormat='{0:F1}°C'}"
               FontSize="32"
               HorizontalOptions="Center" />

        <Label Text="{Binding Latitude, StringFormat='Latitudine: {0:F4}'}"
               FontSize="20"
               HorizontalOptions="Center" />

        <Label Text="{Binding Longitude, StringFormat='Longitudine: {0:F4}'}"
               FontSize="20"
               HorizontalOptions="Center" />

    </StackLayout>
</ContentPage>